# Telegram
BOT_TOKEN=your_bot_token_here

# Claude API
CLAUDE_API_KEY=your_claude_api_key_here

# Paths (absolute path to your Obsidian vault and transcripts folder)
VAULT_PATH=/path/to/your/obsidian-vault
TRANSCRIPTS_INBOX=/path/to/your/transcripts-inbox

# Telegram user ID (get it by sending /start to bot with empty ALLOWED_CHAT_ID)
ALLOWED_CHAT_ID=

# Knowledge Engine (optional)
KE_SYNTHESIS_CRON=0 9 * * *
KE_MIN_IDEAS_FOR_SYNTHESIS=1

# Jira Integration
JIRA_URL=https://your-jira-server.com
JIRA_TOKEN=your_personal_access_token_here
JIRA_SYNC_CRON=0 */3 * * *

# OpenRouter API key (optional, for meeting transcription via OpenRouter)
OPENROUTER_API_KEY=

# --- Langfuse LLM Observability (BL-166) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_ENABLED=true
LANGFUSE_DB_PASSWORD=langfuse_secret
LANGFUSE_NEXTAUTH_SECRET=changeme_langfuse_secret
LANGFUSE_SALT=changeme_langfuse_salt
