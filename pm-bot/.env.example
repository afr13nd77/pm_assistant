# Telegram
BOT_TOKEN=your_bot_token_here

# Claude API
CLAUDE_API_KEY=your_claude_api_key_here

# Пути (Windows-стиль с обратными слешами — в docker-compose используй прямые)
# Пример: C:/Users/YourName/Documents/ObsidianVault
VAULT_PATH=C:/Users/YourName/Documents/ObsidianVault

# Папка, куда ты кидаешь транскрипты из Яндекс Телемост
TRANSCRIPTS_INBOX=C:/Users/YourName/Downloads/Telemost

# Твой Telegram user ID (узнаешь после первого запуска — бот напишет его)
ALLOWED_CHAT_ID=

# --- Idea Pipeline ---
# URL idea-pipeline API (внутри Docker: http://idea-pipeline:8100)
PIPELINE_API_URL=http://idea-pipeline:8100

# API key для аутентификации pipeline (пустой = dev mode без авторизации)
PIPELINE_API_KEY=

# Host и port для idea-pipeline сервера
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8100

# Override модели для отдельных агентов (по умолчанию claude-sonnet-4-6)
# PIPELINE_ANALYST_MODEL=claude-sonnet-4-6
# PIPELINE_PM_MODEL=claude-sonnet-4-6
# PIPELINE_DECOMPOSER_MODEL=claude-sonnet-4-6
